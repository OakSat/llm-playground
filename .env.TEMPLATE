# Copy to .env and edit. .env is gitignored.

# Where Ollama is listening. A bare host:port is accepted too.
# Under docker compose this becomes http://ollama:11434.
OLLAMA_HOST=http://localhost:11434

# Model selected when the playground first loads.
PLAYGROUND_MODEL=llama3.2

# Port the playground listens on. On macOS, port 5000 is taken by the
# AirPlay Receiver, which answers requests with 403 - either set another
# port here or turn AirPlay Receiver off in System Settings > General >
# AirDrop & Handoff.
PLAYGROUND_PORT=5000

# Seconds to wait for a response. Reasoning models on a laptop
# routinely need more than the 30s that v0.1 allowed.
PLAYGROUND_REQUEST_TIMEOUT=120

# --- Abilities -------------------------------------------------------
# Each is independent: 1/true/yes/on to enable, 0/false/no/off to disable.
# These are enforced by the server, not just hidden in the interface.

# Stream tokens as they are generated, rather than waiting for the whole reply.
FEATURE_STREAMING=1

# Remember earlier turns of the conversation.
FEATURE_MULTI_TURN=1

# Choose between installed models from the interface.
FEATURE_MODEL_SWITCHER=1

# Run one prompt against two configurations side by side.
FEATURE_COMPARE=1

# Force replies to match a JSON Schema.
FEATURE_STRUCTURED_OUTPUT=1

# Show the scratchpad of reasoning models such as deepseek-r1.
FEATURE_REASONING=1

# Report tokens, tokens/sec and context usage for each reply.
FEATURE_STATS=1
